<Project>

  <!--
    Shared build settings for every Sentinel sample. Samples live OUTSIDE the library's own
    Directory.Build.props (this file shadows it — MSBuild stops at the nearest one), so it pins
    the target framework and language options, and exposes $(SentinelSrc) so sample projects can
    reference the library source by relative path regardless of how deeply they are nested.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- Samples are teaching code; do not fail the build on analyzer/style warnings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Absolute path to the library source, derived from this file's location. -->
    <SentinelSrc>$(MSBuildThisFileDirectory)../src</SentinelSrc>
    <!--
      Dual-mode framework reference (mirrors the Relay samples trick). Inside the
      monorepo the library source exists at $(SentinelSrc) and samples build against it via
      ProjectReference. In the public examples mirror (github.com/nuvoralabs/sentinel-examples)
      the source is absent, so Directory.Build.targets rewrites those ProjectReferences into
      PackageReferences pinned to $(SentinelVersion) — stamped into sentinel-version.props by
      the sync workflow.
    -->
    <SentinelUseSource Condition="'$(SentinelUseSource)' == '' and Exists('$(SentinelSrc)/Nuvora.Nexus.Sentinel/Nuvora.Nexus.Sentinel.csproj')">true</SentinelUseSource>
    <SentinelUseSource Condition="'$(SentinelUseSource)' == ''">false</SentinelUseSource>
  </PropertyGroup>

  <!-- Generated by the examples-repo sync; never exists in the monorepo. -->
  <Import Project="$(MSBuildThisFileDirectory)sentinel-version.props" Condition="Exists('$(MSBuildThisFileDirectory)sentinel-version.props')" />

</Project>
