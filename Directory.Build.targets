<Project>

  <!--
    Package-mode reference switch (see Directory.Build.props). When the library source is not
    present ($(SentinelUseSource) != true — i.e. building the public examples mirror), every
    ProjectReference to a library project (all named Nuvora.Nexus.Sentinel*) is replaced by a
    PackageReference to the identically-named NuGet package at $(SentinelVersion).
    Sample-to-sample ProjectReferences are untouched. Inside the monorepo this is a no-op.

    The swap lives in a target, not a bare ItemGroup: %(Filename) in an item Condition only
    batches per item inside a target. Outside one it silently selects nothing, which left the
    mirror building against ProjectReferences to a directory that does not exist there.
    BeforeTargets covers both halves — CollectPackageReferences is the restore-time hook that
    feeds NuGet, ResolveProjectReferences/ResolveAssemblyReferences the build-time one.
  -->
  <Target Name="_SentinelSwapFrameworkReferences"
          BeforeTargets="CollectPackageReferences;ResolveProjectReferences;ResolveAssemblyReferences"
          Condition="'$(SentinelUseSource)' != 'true'">
    <ItemGroup>
      <_SentinelFrameworkReference Include="@(ProjectReference)"
                                   Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nuvora.Nexus.Sentinel'))" />
      <ProjectReference Remove="@(_SentinelFrameworkReference)" />
      <PackageReference Include="@(_SentinelFrameworkReference->'%(Filename)')" Version="$(SentinelVersion)" />
    </ItemGroup>

    <!-- Checked here rather than in its own target so it always runs after the swap above has
         populated the item — target ordering between two BeforeTargets hooks is otherwise
         unspecified. -->
    <Error Condition="'$(SentinelVersion)' == '' and '@(_SentinelFrameworkReference)' != ''"
           Text="SentinelVersion is not set. Building the samples outside the monorepo requires sentinel-version.props (generated by the examples-repo sync) or -p:SentinelVersion=&lt;version&gt;." />
  </Target>

</Project>
